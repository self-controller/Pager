{
  "name": "pager",
  "version": "0.1.0",
  "private": true,
  "description": "A Substack-style reading app shell: point it at books and articles on disk and read them in a clean column. Smart tools plug in later.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "VITE_API_URL=http://localhost:3006 vite",
    "dev:server": "PAGER_DATA_DIR=server/.data-dev cargo run --quiet --manifest-path server/Cargo.toml --bin pager-server",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write src test vite.config.ts"
  },
  "dependencies": {
    "@fontsource/spectral": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.61.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
